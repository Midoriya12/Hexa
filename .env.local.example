# Copy this file to .env.local and fill in real values.
# .env.local is gitignored (matches .env*.local pattern in .gitignore).
# NEVER commit real keys.

# ---------- Client-side (bundled into the app) ----------
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_MAPTILER_KEY=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_SENTRY_DSN=

# ---------- Server-only (Edge Functions / scripts / CI) ----------
# DO NOT prefix with EXPO_PUBLIC_ — these must never be bundled into the client.
SUPABASE_SERVICE_ROLE_KEY=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
OPENWEATHER_API_KEY=
