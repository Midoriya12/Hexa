# Copy this file to .env.local and fill in real values.
# .env.local is gitignored (matches .env*.local pattern in .gitignore).
# NEVER commit real keys.

# ---------- Client-side (bundled into the app) ----------
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_MAPBOX_PUBLIC_TOKEN=          # pk.* — safe to bundle, scoped per-app
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_SENTRY_DSN=

# ---------- Server-only / build-time (Edge Functions, scripts, EAS) ----------
# DO NOT prefix with EXPO_PUBLIC_ — these must never be bundled into the client.
SUPABASE_SERVICE_ROLE_KEY=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
OPENWEATHER_API_KEY=
MAPBOX_SECRET_TOKEN=                       # sk.* with DOWNLOADS:READ scope.
                                           # Used at BUILD TIME by the Expo plugin to
                                           # fetch the native SDK from Mapbox's private
                                           # npm registry. Move to EAS secrets before
                                           # any real build (eas secret:create).
